<?xml version="1.0" ?>
<!--
  Kinematic description of the 009 AMR for robot_state_publisher.

  This is deliberately a plain URDF, not a xacro: nothing here is parameterised,
  and every template layer added to a TF tree is another place a frame name can go
  wrong.

  The numbers are copied from assets/models/amr_4wd/model.sdf.in, and the asset
  validator cross checks the two so they cannot silently drift apart. If they
  disagree, TF says the lidar is somewhere the physics says it is not, and the
  costmap is built from a lidar that is not where the robot thinks it is.

  Frame chain, before the launch file adds its <robot>/ prefix:
      base_footprint  (ground projection, z = 0)
        base_link     (z = 0.175)
          wheel_front_left / wheel_rear_left / wheel_front_right /
          wheel_rear_right   (z = 0.075 world -> -0.10 relative to base_link)
          laser_link  (x = 0.20, z = 0.30 world -> +0.125 relative to base_link)

  Wheel frames: the joint origin is IDENTITY and the axis is +y.

  The cylinder is a Z-axis shape in both URDF and SDF, so each wheel's visual and
  collision carry rpy = (pi/2, 0, 0), which turns the cylinder's axis onto y. That
  rotation must NOT also be applied to the joint. A joint origin of rpy = (pi/2, 0, 0)
  rotates the whole child frame, which turns the y-axis cylinder back onto z, leaving
  four flat discs dragged along the floor while the joint spins about z.

  Measured with that arrangement: the robot reached 0.043 m/s of a commanded 0.20 m/s and
  turned 7.9 deg of a commanded 86 deg, with odometry reporting 61.6 deg. Everything
  downstream follows from it: AMCL drifting 3.73 m, the steering wandering away from the
  planned path, and the corridor crossing failing. See docs/IMPLEMENTATION_STATUS.md.
-->
<robot name="amr_4wd">

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.45 0.20"/></geometry>
      <material name="deck"><color rgba="0.26 0.31 0.38 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.60 0.45 0.20"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="22.0"/>
      <inertia ixx="0.70" ixy="0" ixz="0" iyy="1.10" iyz="0" izz="1.55"/>
    </inertial>
  </link>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.045"/></geometry>
      <material name="mast"><color rgba="0.10 0.10 0.10 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.045"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="wheel_front_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.075" length="0.040"/></geometry>
      <material name="tyre"><color rgba="0.12 0.12 0.12 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.075" length="0.040"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.4"/>
      <inertia ixx="0.0025" ixy="0" ixz="0" iyy="0.0047" iyz="0" izz="0.0025"/>
    </inertial>
  </link>

  <link name="wheel_rear_left">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.075" length="0.040"/></geometry>
      <material name="tyre"><color rgba="0.12 0.12 0.12 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.075" length="0.040"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.4"/>
      <inertia ixx="0.0025" ixy="0" ixz="0" iyy="0.0047" iyz="0" izz="0.0025"/>
    </inertial>
  </link>

  <link name="wheel_front_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.075" length="0.040"/></geometry>
      <material name="tyre"><color rgba="0.12 0.12 0.12 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.075" length="0.040"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.4"/>
      <inertia ixx="0.0025" ixy="0" ixz="0" iyy="0.0047" iyz="0" izz="0.0025"/>
    </inertial>
  </link>

  <link name="wheel_rear_right">
    <visual>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.075" length="0.040"/></geometry>
      <material name="tyre"><color rgba="0.12 0.12 0.12 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      <geometry><cylinder radius="0.075" length="0.040"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.4"/>
      <inertia ixx="0.0025" ixy="0" ixz="0" iyy="0.0047" iyz="0" izz="0.0025"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.175" rpy="0 0 0"/>
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.20 0 0.125" rpy="0 0 0"/>
  </joint>

  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.26 0.205 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left"/>
    <origin xyz="-0.26 0.205 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <origin xyz="0.26 -0.205 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right"/>
    <origin xyz="-0.26 -0.205 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
