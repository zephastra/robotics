<?xml version="1.0" ?>
<package format="3">
  <!--
    fleet_interfaces: the ROS surface of the fleet. Messages, services and one
    action; no logic.

    Separate from fleet_ros because a package that generates interfaces and a
    package that installs Python nodes have different build types, and mixing them
    makes the rosidl generation step depend on the node layout.

    The shapes mirror docs/CONTRACTS.md sections 2, 3 and 4. Where the document and
    this file disagree, the document is the design and this file is a bug.

    (Note for whoever edits this file next: this project has now lost four separate
    runs to a double hyphen inside an XML comment. scripts/check_xml_wellformed.py
    catches it, but only if it is run.)
  -->
  <name>fleet_interfaces</name>
  <version>0.1.0</version>
  <description>009 fleet interfaces: permits, robot state, task submission and the ExecuteLeg action.</description>
  <maintainer email="ziling@zephastra.local">ziling</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>unique_identifier_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
