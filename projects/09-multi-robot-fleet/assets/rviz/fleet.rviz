Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /FleetRegions1
      Splitter Ratio: 0.5
    Tree Height: 620
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    # Fixed frame is map, and every pose in this project is published in map. The
    # odometry frames are <robot>/odom and their origins are the spawn poses -- a
    # display set to one of those would silently re-origin every robot, which is the
    # frame mistake that already cost this project two runs.
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 160
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.6
      Frames:
        All Enabled: false
        map:
          Value: true
        r01/base_link:
          Value: true
        r02/base_link:
          Value: true
        r03/base_link:
          Value: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.7
      Color Scheme: map
    # The reservable regions, straight from the config the gate enforces. Read-only:
    # this is the same geometry, drawn, not a second definition of it.
    - Class: rviz_default_plugins/MarkerArray
      Name: FleetRegions
      Enabled: true
      Topic:
        Value: /fleet/markers
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: r01 scan
      Enabled: true
      Topic:
        Value: /r01/scan
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.03
      Color: 0; 170; 255
    - Class: rviz_default_plugins/LaserScan
      Name: r02 scan
      Enabled: true
      Topic:
        Value: /r02/scan
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.03
      Color: 0; 255; 170
    - Class: rviz_default_plugins/LaserScan
      Name: r03 scan
      Enabled: true
      Topic:
        Value: /r03/scan
        Reliability Policy: Best Effort
      Style: Flat Squares
      Size (m): 0.03
      Color: 255; 170; 0
    - Class: rviz_default_plugins/Path
      Name: r01 plan
      Enabled: true
      Topic:
        Value: /r01/plan
        Reliability Policy: Reliable
      Color: 0; 170; 255
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: r02 plan
      Enabled: true
      Topic:
        Value: /r02/plan
        Reliability Policy: Reliable
      Color: 0; 255; 170
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: r03 plan
      Enabled: true
      Topic:
        Value: /r03/plan
        Reliability Policy: Reliable
      Color: 255; 170; 0
      Line Style: Lines
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: r01 amcl
      Enabled: true
      Topic:
        Value: /r01/amcl_pose
        Reliability Policy: Reliable
      Covariance:
        Value: true
      Shape: Arrow
      Color: 0; 170; 255
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.55
      Yaw: 0
Window Geometry:
  Height: 900
  Width: 1500
