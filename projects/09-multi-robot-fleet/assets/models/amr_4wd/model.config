<?xml version="1.0"?>
<model>
  <name>009 AMR (four-wheel skid steer)</name>
  <version>0.1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
    <name>Zephastra Robotics / 009</name>
  </author>
  <description>
    Original four-wheel skid-steer AMR for project 009. 0.60 x 0.45 m footprint
    with the wheels inside it, 0.41 m track, 0.52 m wheelbase, 360-sample
    gpu_lidar. DiffDrive drives front+rear together per side. Not ackermann and
    not omnidirectional; see the notes at the top of model.sdf.

    Geometry here is a first design and is NOT calibrated: P2 measures the real
    stop distance from this model and then freezes footprint, speed and docking
    thresholds.
  </description>
</model>
