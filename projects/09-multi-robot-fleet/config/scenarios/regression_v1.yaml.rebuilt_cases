        node: fleet_task_service
      when:
        request_id: f11-run
        state: EXECUTING
    observe_s: 900.0
    truth: fleet_recorder
    behavior_checks:
    - no_duplicate_task
    expect:
      behavior: PASS
      safety: PASS
      task: NEEDS_ATTENTION
    note: 'Section 5''s claim is 新 epoch 对账，旧任务不重复执行, and both halves are checked from the service''s own
      report rather than from the runner''s intentions: the epoch is a fresh random per process, so a value
      that did not change means the process never came back; and every task that was IN SERVICE when it
      died must be accounted for at the end -- parked by the boot reconciliation with `INTERRUPTED_BY_RESTART`,
      which is the only thing that writes task state outside the state machine, or legitimately finished.
      `no_duplicate_task` is the second half: one ledger row per request id.

      '
