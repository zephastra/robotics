# 008 local configuration example.
# Copy to `.env` and fill in locally. `.env` is git-ignored. Never commit real keys.

# Provider-agnostic planner HTTP bridge (see docs/MASTER_PLAN.md section 12).
# Leave empty to run rule / replay planning only. An empty endpoint means
# `--planner llm` must fail explicitly, not silently fall back to rule.
H008_PLANNER_ENDPOINT=
H008_PLANNER_API_KEY=
H008_PLANNER_REQUEST_TIMEOUT_S=15
H008_PLANNER_MAX_RESPONSE_BYTES=65536

# MuJoCo rendering backend (simulation profile only).
MUJOCO_GL=egl
