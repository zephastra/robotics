  <joint name="left_wheel_joint" type="revolute">
    <parent link="base_link" />
    <child link="left_wheel" />
    <origin xyz="0 0.34 0.12" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1000000000000.0" upper="1000000000000.0" effort="1000" velocity="8.0" />
  </joint>
  <joint name="right_wheel_joint" type="revolute">
    <parent link="base_link" />
    <child link="right_wheel" />
    <origin xyz="0 -0.34 0.12" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-1000000000000.0" upper="1000000000000.0" effort="1000" velocity="8.0" />
  </joint>
  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="front_caster" />
    <origin xyz="0.28 0 0.06" rpy="0 0 0" />
  </joint>
  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="rear_caster" />
    <origin xyz="-0.28 0 0.06" rpy="0 0 0" />
  </joint>
  <joint name="tray_joint" type="fixed">
    <parent link="base_link" />
    <child link="tray" />
    <origin xyz="-0.24 0 0.41" rpy="0 0 0" />
  </joint>
  <joint name="column_joint" type="fixed">
    <parent link="base_link" />
    <child link="column" />
    <origin xyz="0 0 0.48" rpy="0 0 0" />
  </joint>
  <joint name="lift" type="prismatic">
    <parent link="base_link" />
    <child link="carriage" />
    <origin xyz="0 0 0.65" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="0" upper="0.55" effort="1000" velocity="0.6" />
  </joint>
  <joint name="shoulder" type="revolute">
    <parent link="carriage" />
    <child link="upper_arm" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="1000" velocity="0.6" />
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm" />
    <child link="forearm" />
    <origin xyz="0.42 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="1000" velocity="0.6" />
  </joint>
  <joint name="wrist" type="revolute">
    <parent link="forearm" />
    <child link="tool" />
    <origin xyz="0.40 0 -0.30" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.14" upper="3.14" effort="1000" velocity="0.6" />
  </joint>
  <joint name="finger_left" type="prismatic">
    <parent link="tool" />
    <child link="finger_left_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="0.05" upper="0.095" effort="1000" velocity="0.6" />
  </joint>
  <joint name="finger_right" type="prismatic">
    <parent link="tool" />
    <child link="finger_right_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="0.05" upper="0.095" effort="1000" velocity="0.6" />
  </joint>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_link" />
    <origin xyz="0.14 0 0.60" rpy="0 0 0" />
  </joint>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.3 0 1.8" rpy="0 0 0" />
  </joint>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_mast" />
    <origin xyz="-0.34 -0.22 1.03" rpy="0 0 0" />
  </joint>
</robot>