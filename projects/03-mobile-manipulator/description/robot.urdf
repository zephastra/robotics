  <link name="finger_left_link">
    <visual>
      <origin xyz="0 0.006 0.015" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.012 0.11" />
      </geometry>
      <material name="finger_left_linkvisual">
        <color rgba="0.35 0.38 0.42 1" />
