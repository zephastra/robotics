<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="amr_world">

    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="room">
      <static>true</static>
      <link name="wall_north">
        <collision name="c">
          <pose>0 5.5 0.75 0 0 0</pose>
          <geometry><box><size>13 0.3 1.5</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>0 5.5 0.75 0 0 0</pose>
          <geometry><box><size>13 0.3 1.5</size></box></geometry>
          <material><ambient>0.72 0.72 0.78 1</ambient><diffuse>0.72 0.72 0.78 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_south">
        <collision name="c">
          <pose>0 -5.5 0.75 0 0 0</pose>
          <geometry><box><size>13 0.3 1.5</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>0 -5.5 0.75 0 0 0</pose>
          <geometry><box><size>13 0.3 1.5</size></box></geometry>
          <material><ambient>0.72 0.72 0.78 1</ambient><diffuse>0.72 0.72 0.78 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_west">
        <collision name="c">
          <pose>-6.5 0 0.75 0 0 0</pose>
          <geometry><box><size>0.3 13 1.5</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>-6.5 0 0.75 0 0 0</pose>
          <geometry><box><size>0.3 13 1.5</size></box></geometry>
          <material><ambient>0.72 0.72 0.78 1</ambient><diffuse>0.72 0.72 0.78 1</diffuse></material>
        </visual>
      </link>
      <link name="wall_east">
        <collision name="c">
          <pose>6.5 0 0.75 0 0 0</pose>
          <geometry><box><size>0.3 13 1.5</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>6.5 0 0.75 0 0 0</pose>
          <geometry><box><size>0.3 13 1.5</size></box></geometry>
          <material><ambient>0.72 0.72 0.78 1</ambient><diffuse>0.72 0.72 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacles">
      <static>true</static>
      <link name="pillar_1">
        <collision name="c">
          <pose>2.5 2.0 0.5 0 0 0</pose>
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>2.5 2.0 0.5 0 0 0</pose>
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_2">
        <collision name="c">
          <pose>3.0 -3.0 0.5 0 0 0</pose>
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>3.0 -3.0 0.5 0 0 0</pose>
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_3">
        <collision name="c">
          <pose>-2.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>-2.5 2.5 0.5 0 0 0</pose>
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="pillar_4">
        <collision name="c">
          <pose>-3.0 -1.5 0.5 0 0 0</pose>
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>-3.0 -1.5 0.5 0 0 0</pose>
          <geometry><box><size>0.6 0.6 1.0</size></box></geometry>
          <material><ambient>0.45 0.35 0.2 1</ambient><diffuse>0.45 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
      <link name="shelf">
        <collision name="c">
          <pose>1.0 -2.5 0.6 0 0 0.3</pose>
          <geometry><box><size>2.0 0.4 1.2</size></box></geometry>
        </collision>
        <visual name="v">
          <pose>1.0 -2.5 0.6 0 0 0.3</pose>
          <geometry><box><size>2.0 0.4 1.2</size></box></geometry>
          <material><ambient>0.2 0.4 0.55 1</ambient><diffuse>0.2 0.4 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="amr">
      <pose>0 0 0 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <pose>-0.03 0 0.09 0 0 0</pose>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.06</ixx><iyy>0.05</iyy><izz>0.08</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="c">
          <!-- Keep the chassis clear of the floor so only wheels/caster contact it. -->
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><box><size>0.4 0.26 0.12</size></box></geometry>
          <surface><friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><box><size>0.4 0.26 0.12</size></box></geometry>
          <material><ambient>0.15 0.35 0.7 1</ambient><diffuse>0.15 0.35 0.7 1</diffuse></material>
        </visual>
      </link>

      <link name="left_wheel">
        <!-- ROS convention: +Y is the robot's left side. -->
        <pose relative_to="base_link">0 0.15 0.05 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="c">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose relative_to="base_link">0 -0.15 0.05 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia>
            <ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="c">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <pose>0 0 0 1.5707963 0 0</pose>
          <geometry><cylinder><radius>0.05</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
        </visual>
      </link>

      <link name="caster">
        <pose relative_to="base_link">-0.14 0 0.02 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="c">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
        </collision>
        <visual name="v">
          <geometry><sphere><radius>0.02</radius></sphere></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
      </link>

      <link name="lidar_link">
        <pose relative_to="base_link">0 0 0.20 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="v">
          <geometry><cylinder><radius>0.03</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
        <sensor type="gpu_lidar" name="lidar">
          <pose>0 0 0.02 0 0 0</pose>
          <topic>/scan</topic>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <visualize>true</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265358979</min_angle>
                <max_angle>3.14159265358979</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.15</min>
              <max>12.0</max>
            </range>
          </lidar>
        </sensor>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <pose relative_to="left_wheel">0 0 0 0 0 0</pose>
        <axis><xyz expressed_in="base_link">0 1 0</xyz></axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <pose relative_to="right_wheel">0 0 0 0 0 0</pose>
        <axis><xyz expressed_in="base_link">0 1 0</xyz></axis>
      </joint>

      <joint name="caster_joint" type="fixed">
        <parent>base_link</parent>
        <child>caster</child>
        <pose relative_to="caster">0 0 0 0 0 0</pose>
      </joint>

      <joint name="lidar_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_link</child>
        <pose relative_to="lidar_link">0 0 0 0 0 0</pose>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.30</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <odom_publish_frequency>20</odom_publish_frequency>
        <topic>/model/amr/cmd_vel</topic>
        <odom_topic>/model/amr/odometry</odom_topic>
        <publish_odom>true</publish_odom>
        <publish_wheel_tf>false</publish_wheel_tf>
      </plugin>

    </model>
  </world>
</sdf>
